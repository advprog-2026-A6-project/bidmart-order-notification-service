        {
          "expr": "(sum(rate(http_server_requests_seconds_bucket{application=\"bidmart-order-notification-service\",le=\"0.5\"}[5m])) + sum(rate(http_server_requests_seconds_bucket{application=\"bidmart-order-notification-service\",le=\"2.0\"}[5m])) / 2) / sum(rate(http_server_requests_seconds_count{application=\"bidmart-order-notification-service\"}[5m]))",
